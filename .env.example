# Copy this file to .env.local and fill in what you have.
# Anything left blank shows realistic mock data, marked "Sample data" in the app.

# --- Claude (AI agent) ---
ANTHROPIC_API_KEY=

# --- Mercury (one token covers all accounts in your Mercury org) ---
# Mercury dashboard > Settings > API tokens (read-only is enough)
MERCURY_API_TOKEN=

# --- Stripe: one secret per account. The <KEY> matches "stripe" in data/businesses.json ---
# Use restricted keys with read access to Charges, Subscriptions, Balance.
STRIPE_ASKAWAY_SECRET_KEY=
STRIPE_SITCOM_SECRET_KEY=
STRIPE_LITTLETAN_SECRET_KEY=

# --- Shopify: one store + Admin API token per store (custom app with read_orders) ---
SHOPIFY_HOMELOVE_STORE=your-store.myshopify.com
SHOPIFY_HOMELOVE_TOKEN=
SHOPIFY_LITTLETAN_STORE=your-store.myshopify.com
SHOPIFY_LITTLETAN_TOKEN=

# --- Gmail: one Google OAuth client, one refresh token per inbox ---
# Run `npm run gmail:auth -- ASKAWAY` to generate a refresh token for an inbox.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_ASKAWAY_REFRESH_TOKEN=
GMAIL_SITCOM_REFRESH_TOKEN=
GMAIL_HOMELOVE_REFRESH_TOKEN=
GMAIL_LITTLETAN_REFRESH_TOKEN=

# Your first name for the greeting on Today
OWNER_NAME=Scott

# Hosted only: password for the login screen
APP_PASSWORD=
